# LLM provider for the Intake, Policy Retrieval synthesis, and Adjudication agents.
# Runs fully local via Ollama by default -- no API key, no per-call cost.
# `ollama pull llama3.2:3b` before running. For better local quality (if you
# have the RAM), swap to a model you already have pulled, e.g. llama3.1:8b.
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434

# Embedding model for policy document retrieval, served by the same Ollama
# instance. all-minilm is small enough for the deployed container; swap to
# bge-m3 locally for better retrieval quality if you have it pulled.
# `ollama pull all-minilm`
EMBEDDING_MODEL=all-minilm

# Paths (defaults shown; override if your layout differs)
DATA_DIR=data
POLICY_DOCS_DIR=data/policy_docs
QDRANT_PATH=data/qdrant
QDRANT_COLLECTION_NAME=policy_clauses
RAW_CLAIMS_DATASET=data/raw/claims.csv
FRAUD_MODEL_PATH=models/fraud_classifier.joblib
