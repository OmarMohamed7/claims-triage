# LLM provider for the Intake and Adjudication agents: ollama | gemini | groq
# ollama: local, no key (`ollama pull llama3.2:3b`)
# gemini: LLM_MODEL=gemini-3.5-flash-lite, needs GEMINI_API_KEY
# groq:   LLM_MODEL=llama-3.3-70b-versatile, needs GROQ_API_KEY
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434
GEMINI_API_KEY=
GROQ_API_KEY=

# Embedding model for policy retrieval, run locally in-process via fastembed
# (no server, no API key). Downloaded on first use. Changing it requires
# rebuilding the index: uv run python -m scripts.build_policy_index
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Paths (defaults shown; override if your layout differs)
DATA_DIR=data
POLICY_DOCS_DIR=data/policy_docs
QDRANT_PATH=data/qdrant
QDRANT_COLLECTION_NAME=policy_clauses
RAW_CLAIMS_DATASET=data/raw/claims.csv
FRAUD_MODEL_PATH=models/fraud_classifier.joblib
