# LLM provider for the Intake and Adjudication agents: ollama | gemini | vertex | groq
# ollama: local, no key (`ollama pull llama3.2:3b`)
# gemini: LLM_MODEL=gemini-3.5-flash-lite, needs GEMINI_API_KEY
# vertex: Gemini through Vertex AI with Application Default Credentials (no API key).
#         Needs GCP_PROJECT (optional if ADC has one) and GCP_LOCATION (default: global).
#         Local: gcloud auth application-default login. On Cloud Run: the service account.
# groq:   LLM_MODEL=qwen/qwen3.8-27b, needs GROQ_API_KEY
LLM_PROVIDER=groq
LLM_MODEL=qwen/qwen3.8-27b
OLLAMA_BASE_URL=http://localhost:11434
GEMINI_API_KEY=
GROQ_API_KEY=
# Models users may pick in the UI, as comma-separated provider:model. The default
# above is always included, e.g. LLM_CHOICES=vertex:gemini-3.5-flash-lite,groq:qwen/qwen3.8-27b
LLM_CHOICES=
GCP_PROJECT=
GCP_LOCATION=global

# Embedding model for policy retrieval, run locally in-process via fastembed
# (no server, no API key). Downloaded on first use. Changing it requires
# rebuilding the index: uv run python -m scripts.build_policy_index
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Paths (defaults shown; override if your layout differs)
DATA_DIR=data
POLICY_DOCS_DIR=data/policy_docs
QDRANT_PATH=data/qdrant
QDRANT_COLLECTION_NAME=policy_clauses
RAW_CLAIMS_DATASET=data/raw/claims.csv
FRAUD_MODEL_PATH=models/fraud_classifier.joblib

# Optional: Supabase Postgres connection string (pooler URI) for the adjudicator queue; SQLite is used when empty
REVIEWS_DATABASE_URL=
